    UserModel --> Redis
    IssueModel --> Redis
    OrgModel --> Redis
    AppealModel --> Redis
    
    Redis --> ServerCache
    ServerCache --> InvalidationEngine
    
    UserModel --> MySQL
    IssueModel --> MySQL
    OrgModel --> MySQL
    AppealModel --> MySQL
    
    AIService --> GoogleAI
    EmailService --> EmailProvider
