# CivicResolve Environment Configuration
# Copy this file to .env.local and fill in your values

# ========================================
# DATABASE CONFIGURATION (Required)
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=civicresolve

# ========================================
# REDIS CACHE CONFIGURATION (Optional but Recommended)
# ========================================
# Redis connection URL for caching (improves performance significantly)
# Local Redis: redis://localhost:6379
# Redis Cloud: redis://username:password@hostname:port
REDIS_URL=redis://localhost:6379

# Redis connection pool settings (optional, has sensible defaults)
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# ========================================
# AUTHENTICATION (Required)
# ========================================
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_required_for_security

# ========================================
# AI FEATURES (Required for AI Functionality)
# ========================================
# Google Gemini API key for AI features
# Get your key from: https://makersuite.google.com/app/apikey
# Powers: AI image analysis, auto-fill reports, chat assistant
GEMINI_API_KEY=your_google_gemini_api_key_here

# Alternative key name (for compatibility)
# GOOGLE_AI_API_KEY=your_google_gemini_api_key_here

# AI Feature Configuration (Optional)
# Enable/disable specific AI features
ENABLE_AI_AUTO_FILL=true
ENABLE_AI_IMAGE_ANALYSIS=true
ENABLE_AI_CHAT_ASSISTANT=true

# AI Performance Settings (Optional)
AI_REQUEST_TIMEOUT=30000    # Timeout in milliseconds (30 seconds)
AI_MAX_IMAGE_SIZE=5242880   # Max image size in bytes (5MB)

# ========================================
# APPLICATION CONFIGURATION (Required)
# ========================================
# Base URL for the application (used in emails and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# ========================================
# EMAIL CONFIGURATION (Optional but Recommended)
# ========================================
# Email service configuration for notifications
# If not configured, email features will be disabled gracefully

# SMTP Configuration (for production email notifications)
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USER=your-email@domain.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@your-domain.com

# Email Feature Controls (Optional)
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_ASSIGNMENT_EMAILS=true
ENABLE_STATUS_UPDATE_EMAILS=true

# ========================================
# PERFORMANCE & MONITORING (Optional)
# ========================================
# Performance monitoring and optimization settings

# Enable performance monitoring dashboard
ENABLE_PERFORMANCE_MONITORING=true

# Cache configuration
ENABLE_CACHE_LOGGING=true        # Detailed cache operation logs
CACHE_DEFAULT_TTL=300            # Default cache TTL in seconds (5 minutes)
CACHE_ISSUES_TTL=600             # Issues cache TTL (10 minutes)
CACHE_AI_RESPONSES_TTL=1800      # AI responses cache TTL (30 minutes)

# Logging levels (error, warn, info, debug)
LOG_LEVEL=info

# ========================================
# SECURITY CONFIGURATION (Optional but Recommended)
# ========================================
# Security headers and validation settings

# Enable security headers
ENABLE_SECURITY_HEADERS=true

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000         # Window in milliseconds (1 minute)

# Input validation
MAX_FILE_SIZE=5242880           # Max file upload size (5MB)
MAX_COMMENT_LENGTH=1000         # Max comment length
MAX_ISSUE_TITLE_LENGTH=500      # Max issue title length

# ========================================
# DEVELOPMENT CONFIGURATION (Development Only)
# ========================================
# These settings should only be used in development

# Enable detailed error reporting (NEVER use in production)
ENABLE_DEBUG_MODE=false

# Enable API request logging
ENABLE_API_LOGGING=true

# Skip email sending in development (log to console instead)
SKIP_EMAIL_SENDING=true

# ========================================
# PRODUCTION CONFIGURATION (Production Only)
# ========================================
# These settings are specifically for production deployments

# Production security
# FORCE_HTTPS=true
# SECURE_COOKIES=true

# Production performance
# ENABLE_COMPRESSION=true
# ENABLE_STATIC_OPTIMIZATION=true

# Production monitoring
# ENABLE_ERROR_REPORTING=true
# ERROR_REPORTING_DSN=your-error-tracking-dsn

# ========================================
# FEATURE FLAGS (Optional)
# ========================================
# Enable/disable specific platform features

# Core features
ENABLE_USER_REGISTRATION=true
ENABLE_ISSUE_VOTING=true
ENABLE_ISSUE_COMMENTS=true
ENABLE_MAP_INTERFACE=true

# Organization features
ENABLE_ORGANIZATION_MANAGEMENT=true
ENABLE_ISSUE_ASSIGNMENT=true
ENABLE_BULK_OPERATIONS=true

# Advanced features
ENABLE_ANALYTICS_DASHBOARD=true
ENABLE_EXPORT_FUNCTIONALITY=true
ENABLE_ADVANCED_SEARCH=true

# Experimental features (use with caution)
ENABLE_EXPERIMENTAL_FEATURES=false
# APPLICATION SETTINGS
# ========================================
# Set to 'production' for production deployment
NODE_ENV=development

# Next.js configuration
NEXTAUTH_URL=http://localhost:3000

# ========================================
# AI FEATURES CONFIGURATION (Optional)
# ========================================
# Google Gemini API key for AI-powered image analysis
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# PRODUCTION CHECKLIST
# ========================================
# Before deploying to production:
# 1. Set NODE_ENV=production
# 2. Generate a secure JWT_SECRET (64+ characters)
# 3. Use strong database credentials
# 4. Set NEXTAUTH_URL to your production domain
# 5. Configure GEMINI_API_KEY if using AI features
# 6. Set REDIS_URL for optimal caching performance
# 7. Ensure all values are properly escaped
# 8. Never commit .env.local to version control

# Ollama (local AI) — vision for dev/test. VISION_PROVIDER=local routes image
# calls here; 'gateway' (prod) uses the opencode-go vision model instead.
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen3-vl:8b-thinking
VISION_PROVIDER=gateway

# Opencode AI gateway (primary AI backend)
OPENCODE_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
OPENCODE_CHAT_MODEL=deepseek-v4-flash
OPENCODE_VISION_MODEL=mimo-v2.5

# ========================================
# AI OBSERVATION ENGINE (Phase 0 — external imagery verification)
# ========================================
# Enable the /api/ai/verify-issue endpoint (issue photo vs street imagery)
ENABLE_AI_VERIFICATION=true
# Vision duplicate sweep (background worker pass 2): photo comparison for
# nearby same-category issues → flags pairs for the admin duplicates queue.
ENABLE_AI_DUPLICATE_VISION=true
# Resolution verification (background worker pass 3): proof photo vs original
# report photo — "is the issue actually fixed?" → resolution_verdict columns.
ENABLE_AI_RESOLUTION_CHECK=true
# Auto-discovery (background worker pass 4): scan street imagery near recent
# reports, detect defects with the trained YOLO (ONNX), create CANDIDATE issues.
ENABLE_AI_DISCOVERY=true
# Street-imagery providers, tried in order (leave blank to skip a provider):
# Ola Street View — free 1st year (500K req/mo) — https://maps.olakrutrim.com (register for API key)
OLA_MAPS_API_KEY=
# Mapillary — free client token — https://www.mapillary.com/dashboard/developers
MAPILLARY_CLIENT_TOKEN=
