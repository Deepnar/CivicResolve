# CivicResolve Environment Configuration
# Copy this file to .env.local and fill in your values

# ========================================
# DATABASE CONFIGURATION (Required)
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=civicresolve

# ========================================
# REDIS CACHE CONFIGURATION (Optional but Recommended)
# ========================================
# Redis connection URL for caching (improves performance significantly)
# Local Redis: redis://localhost:6379
# Redis Cloud: redis://username:password@hostname:port
REDIS_URL=redis://localhost:6379

# Redis connection pool settings (optional, has sensible defaults)
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# ========================================
# AUTHENTICATION (Required)
# ========================================
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_required_for_security

# ========================================
# EXTERNAL SERVICES (Optional)
# ========================================
# Google Gemini API key for AI chat feature
GEMINI_API_KEY=your_google_gemini_api_key_here

# ========================================
# APPLICATION SETTINGS
# ========================================
# Set to 'production' for production deployment
NODE_ENV=development

# Next.js configuration
NEXTAUTH_URL=http://localhost:3000

# ========================================
# PRODUCTION CHECKLIST
# ========================================
# Before deploying to production:
# 1. Set NODE_ENV=production
# 2. Generate a secure JWT_SECRET (64+ characters)
# 3. Use strong database credentials
# 4. Set NEXTAUTH_URL to your production domain
# 5. Configure GEMINI_API_KEY if using AI features
# 6. Set REDIS_URL for optimal caching performance
# 7. Ensure all values are properly escaped
# 8. Never commit .env.local to version control
